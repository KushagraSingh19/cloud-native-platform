# =============================================================================
# Cloud-Native Application Deployment & Monitoring Platform — .env.example
# =============================================================================
# Copy this file to `.env` for local Docker Compose usage:
#   cp .env.example .env
#
# IMPORTANT: Never commit `.env` or real secrets to Git!
# =============================================================================

# Application port (defaults to 5001 locally; injected automatically by Render)
PORT=5001

# -----------------------------------------------------------------------------
# Local Grafana Administrator Credentials (used by docker-compose.yml)
# -----------------------------------------------------------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=replace_with_strong_local_grafana_password

# -----------------------------------------------------------------------------
# Prometheus /metrics Endpoint Authentication (Production / Render)
# -----------------------------------------------------------------------------
# Set REQUIRE_METRICS_AUTH=true in production so /metrics fails closed if
# METRICS_TOKEN is missing. Leave false/unset for local Docker Compose so the
# local prometheus-server container can scrape without a token.
REQUIRE_METRICS_AUTH=false

# Generate a random token (e.g. `openssl rand -hex 32`) for production on Render
# and configure the same token in Grafana Cloud's Metrics Endpoint integration.
METRICS_TOKEN=
