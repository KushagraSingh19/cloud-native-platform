# Virtual environments
venv/
ENV/
env/

# Python cache & compiled files
__pycache__/
*.py[cod]
*$py.class

# Pytest & test artifacts
.pytest_cache/
.coverage
htmlcov/

# Git tracking
.git/
.gitignore

# Secrets, credentials & environment files (never bake into image layers)
.env
.env.*
*.pem
*.key
*.crt

# Cloud & local monitoring configs not needed inside app image
render.yaml
prometheus/
grafana/
docker-compose.yml

# OS temporary files
.DS_Store
Thumbs.db

# Documentation & IDE
README.md
.vscode/
.idea/
