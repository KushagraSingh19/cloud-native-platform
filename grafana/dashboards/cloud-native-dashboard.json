{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "title": "Application Availability",
      "description": "Monitors Flask container up status (1 = UP, 0 = DOWN)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "type": "value", "options": { "1": { "text": "UP", "color": "green" }, "0": { "text": "DOWN", "color": "red" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "targets": [{ "expr": "up{job=\"flask-app\"}", "refId": "A" }]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "title": "Total HTTP Requests",
      "description": "Cumulative HTTP requests served across all endpoints",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      },
      "targets": [{ "expr": "sum(http_requests_total)", "refId": "A" }]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "title": "Application Request Rate",
      "description": "HTTP throughput in requests per second",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "reqps",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        }
      },
      "targets": [{ "expr": "sum(rate(http_requests_total[1m])) or vector(0)", "refId": "A" }]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "title": "Active Requests (In Progress)",
      "description": "Number of active concurrent requests currently being processed",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 5 }] }
        }
      },
      "targets": [{ "expr": "sum(http_requests_in_progress)", "refId": "A" }]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 5,
      "title": "Request Latency Over Time",
      "description": "Average response latency in seconds",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth" },
          "unit": "s"
        }
      },
      "targets": [{ "expr": "sum(rate(http_request_duration_seconds_sum[1m])) / sum(rate(http_request_duration_seconds_count[1m]))", "refId": "A", "legendFormat": "Average Latency" }]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 6,
      "title": "HTTP Error Rate (%)",
      "description": "Percentage of requests returning 4xx or 5xx status codes",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line" },
          "unit": "percent",
          "color": { "mode": "fixed", "fixedColor": "red" }
        }
      },
      "targets": [{ "expr": "((sum(rate(http_requests_total{status_code=~\"4..|5..\"}[1m])) or vector(0)) / (sum(rate(http_requests_total[1m])) or vector(1))) * 100", "refId": "A", "legendFormat": "Error Rate %" }]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "id": 7,
      "title": "Requests by HTTP Method",
      "description": "Breakdown of traffic by HTTP Method (GET, POST, PUT, DELETE)",
      "type": "barchart",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [{ "expr": "sum by (method) (http_requests_total)", "refId": "A", "legendFormat": "{{method}}" }]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "id": 8,
      "title": "Requests by HTTP Status Code",
      "description": "Distribution of HTTP response status codes (200, 201, 400, 404)",
      "type": "barchart",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [{ "expr": "sum by (status_code) (http_requests_total)", "refId": "A", "legendFormat": "HTTP {{status_code}}" }]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "id": 9,
      "title": "CPU Usage (%)",
      "description": "Process CPU usage percentage",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      },
      "targets": [{ "expr": "rate(process_cpu_seconds_total[1m]) * 100", "refId": "A", "legendFormat": "CPU Usage" }]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "id": 10,
      "title": "Memory Usage (Resident Memory)",
      "description": "Resident memory size in bytes / MB",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "targets": [{ "expr": "process_resident_memory_bytes", "refId": "A", "legendFormat": "RAM Usage" }]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["cloud-native", "flask", "prometheus"],
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "title": "Cloud-Native Application Monitoring",
  "uid": "cloud-native-dashboard"
}
